# =============================================================================
# ATE Studio — 边缘/工位执行节点（ate-platform）环境变量模板
# =============================================================================
# 用途：在本机（工位/执行节点，Windows 或 Linux）运行 JetStreamWorker，
#       连接调试服务器 192.168.5.24 上的 NATS JetStream。
#
# 用法：
#   Windows PowerShell : 复制为 edge.env，在运行窗口里逐个设置
#       $env:ATE_PLATFORM_NATS_URL="nats://192.168.5.24:4222"（见手册 8.2）。
#   Linux/macOS/WSL bash: cp config/edge-node.env.example config/edge.env
#       编辑后执行：scripts/deploy/run_edge_worker.sh config/edge.env
#       （脚本内部 set -a; source 该文件；故所有值都加引号，便于 source）
#
# 本文件只含占位符与内网地址，**不含任何密钥/密码**；真实凭据不要写进仓库。
# 配套运行手册：docs/部署手册-192.168.5.24调试服务器.md 第 8 节。
# =============================================================================

# -----------------------------------------------------------------------------
# 1) NATS JetStream（必填）— 云端/调试服务器消息总线
# -----------------------------------------------------------------------------
# 边缘 worker 从这里拉取任务、上报状态、接收控制命令（暂停/恢复/断点）。
# 调试服务器固定为 .24:4222（监控页 http://192.168.5.24:8222 ）。
ATE_PLATFORM_NATS_URL="nats://192.168.5.24:4222"

# 兼容旧变量名：docker-compose 里的 ate-platform 服务读 ATE_CLOUD_NATS_URL。
# 裸机/本机运行以上面的 ATE_PLATFORM_NATS_URL 为准；两者一致即可。
ATE_CLOUD_NATS_URL="nats://192.168.5.24:4222"

# -----------------------------------------------------------------------------
# 2) 仿真模式（必填）— 无真实仪器时必须为 true
# -----------------------------------------------------------------------------
# true ：测试脚本/驱动走 MockDriverFactory 虚拟仪器（DMM/PSU 等返回模拟值），
#        不访问任何真实硬件，工位机不需要接 GPIB/LAN 仪器。
# false：连接真实仪器（产线正式投产时才设为 false）。
ATE_SIMULATION_MODE="true"

# -----------------------------------------------------------------------------
# 3) 边缘本地数据目录（必填占位符）— 本地状态与 SQLite 缓存，绝不用 PostgreSQL
# -----------------------------------------------------------------------------
# 该目录保存：worker_id（NATS KV 注册身份，重启复用）、崩溃恢复快照、
# 以及离线自治用的本地 SQLite 缓存（断网缓冲，重连后回传）。
#   <数据目录>/worker_id                 持久化 worker 身份
#   <数据目录>/snapshots/                崩溃恢复状态快照（§6.6，可选）
#   <数据目录>/sqlite/edge-cache.db      离线版本缓存 OfflineCacheStore
#   <数据目录>/sqlite/uploads.db         待上传执行记录队列 UploadQueue（WAL）
# Windows 示例："C:/ate/edge-data"
# Linux 示例  ："/var/lib/ate-platform"
ATE_PLATFORM_DATA_DIR="<EDGE_DATA_DIR>"

# 工位/站点标识（运维命名 + 执行记录 station_id 字段使用；
# 建议如 STATION-AOI-01 / 工位-电源测试-03，全网段唯一）。
ATE_PLATFORM_STATION_ID="<STATION_ID>"

# -----------------------------------------------------------------------------
# 4) 崩溃恢复（可选）
# -----------------------------------------------------------------------------
# 设置后启用 §6.6 状态快照：执行中断（断电/杀进程）后重启自动恢复步骤状态，
# RUNNING/PENDING 步骤回退重跑。默认注释掉（禁用快照）；需要时去掉注释并
# 把路径改成与 ATE_PLATFORM_DATA_DIR 同级的 snapshots 目录，例如：
# ATE_PLATFORM_SNAPSHOT_DIR="/var/lib/ate-platform/snapshots"

# -----------------------------------------------------------------------------
# 5) JetStream 文件存储事件缓冲（可选，默认 true）
# -----------------------------------------------------------------------------
# true：站内事件写入 JetStream 文件存储流（TESTSTATION_EVENTS），
#       NATS 断连/进程重启后事件不丢。边缘节点保持默认即可。
ATE_PLATFORM_NATS_FILE_STORE_ENABLED="true"
