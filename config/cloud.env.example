# =============================================================================
# ATE Studio — CLOUD service (ate_cloud) environment template
# =============================================================================
# For the bare-metal deploy on 192.168.5.25 (ate-cloud.service). Copy this
# file to a NON-repo location, fill in real values, and point deploy_cloud.sh
# at it:
#
#   cp config/cloud.env.example ~/cloud.env          # on your control machine
#   $EDITOR ~/cloud.env                              # replace <...> placeholders
#   ENV_FILE=~/cloud.env ./scripts/deploy/deploy_cloud.sh
#
# The deploy script installs it as ~/ATEStudio/.env.deploy (chmod 600) and the
# systemd unit loads it via EnvironmentFile=. NEVER commit the filled file.
#
# This template contains PLACEHOLDERS and internal hostnames only — NO real
# passwords or API keys. Every variable below traces to code:
#   * ATE_CLOUD_* / prefixed settings  -> src/ate_cloud/config.py (Settings;
#     env_prefix="ATE_CLOUD_"; fields WITHOUT a validation_alias read their
#     UPPERCASE name with the ATE_CLOUD_ prefix)
#   * Explicit validation_alias names  -> config.py (no prefix)
#   * ATE_ADMIN_USERNAME/PASSWORD       -> src/ate_cloud/api/v1/users.py (admin
#     bootstrap) — the old .24 unit already set these
#   * SCRIPTS_ROOT_DIR                  -> src/ate_cloud/main.py
#   * ATE_RECORDINGS_DIR                -> config.py (recordings_dir alias)
# Consistent with env.template (Docker/dev) — same names, host-specific values.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
ATE_CLOUD_APP_NAME="ATE Cloud API"
ATE_CLOUD_DEBUG="false"

# -----------------------------------------------------------------------------
# Database (src/ate_cloud/config.py: database_type, sqlite_db_path, ...)
# .24 runs SQLite in the project data dir. PostgreSQL/MySQL block is unused
# unless ATE_CLOUD_DATABASE_TYPE is switched.
# -----------------------------------------------------------------------------
ATE_CLOUD_DATABASE_TYPE="sqlite"
# Relative to WorkingDirectory (~/ATEStudio) for the systemd service.
ATE_CLOUD_SQLITE_DB_PATH="data/ate_platform.db"
# Connection-pool sizing (RDBMS only; ignored by SQLite).
ATE_CLOUD_DB_POOL_SIZE="5"
ATE_CLOUD_DB_MAX_OVERFLOW="10"
# Optional: force a full DB URL (overrides construction above; alembic CLI
# also honors it). Leave empty normally.
# ATE_CLOUD_DATABASE_URL=""

# --- PostgreSQL (only when ATE_CLOUD_DATABASE_TYPE=postgresql) ---------------
ATE_CLOUD_PG_HOST="localhost"
ATE_CLOUD_PG_PORT="5432"
ATE_CLOUD_PG_USER="<PG_USER>"
ATE_CLOUD_PG_PASSWORD="<PG_PASSWORD>"
ATE_CLOUD_PG_DATABASE="ate_platform"

# --- MySQL (only when ATE_CLOUD_DATABASE_TYPE=mysql) -------------------------
ATE_CLOUD_MYSQL_HOST="localhost"
ATE_CLOUD_MYSQL_PORT="3306"
ATE_CLOUD_MYSQL_USER="<MYSQL_USER>"
ATE_CLOUD_MYSQL_PASSWORD="<MYSQL_PASSWORD>"
ATE_CLOUD_MYSQL_DATABASE="ate_platform"

# -----------------------------------------------------------------------------
# NATS JetStream (config.py: nats_url, nats_file_store_enabled)
# nats.service runs on .24:4222 (monitor http://192.168.5.25:8222).
# -----------------------------------------------------------------------------
ATE_CLOUD_NATS_URL="nats://127.0.0.1:4222"
# File-backed JetStream streams so events survive restarts (RH-2).
ATE_CLOUD_NATS_FILE_STORE_ENABLED="true"

# -----------------------------------------------------------------------------
# Qdrant vector DB (config.py: qdrant_url, qdrant_collection_failures,
# embedding_dimensions). qdrant.service runs on .24:6333 (gRPC 6334).
# Collection: ate_failures (failure + station fault-case index)
# (fault/symptom vectors, see src/ate_cloud/services/fault_symptom_vector_store.py).
# -----------------------------------------------------------------------------
ATE_CLOUD_QDRANT_URL="http://127.0.0.1:6333"
ATE_CLOUD_QDRANT_COLLECTION_FAILURES="ate_failures"
ATE_CLOUD_EMBEDDING_DIMENSIONS="1536"

# -----------------------------------------------------------------------------
# The knowledge-graph backend settings are gone: FALKORDB_URL / FALKORDB_GRAPH /
# FALKORDB_PASSWORD and the older NEO4J_URL / NEO4J_PASSWORD.
#
# Neither names a setting the application still reads — there is no
# graph_service in the code and there is no graph endpoint to point one at. Do
# not add them back "just in case"; an unused connection string in a .env file
# is indistinguishable, to the next reader, from a configured feature.
#
# Fault cases live in Postgres and are retrieved through Qdrant, so the only
# vector-related settings that matter are the four lines above.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# LLM / embeddings (config.py: openai_* — validation_alias, no prefix).
# OpenAI or any OpenAI-compatible endpoint (Aliyun DashScope/Qwen, ...).
# AI features degrade gracefully when unset, but diagnosis/RAG need a key.
# -----------------------------------------------------------------------------
OPENAI_API_KEY="<OPENAI_OR_DASHSCOPE_API_KEY>"
# Empty = OpenAI default. DashScope example:
#   https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# -----------------------------------------------------------------------------
# JWT auth (config.py: jwt_secret / jwt_algorithm / jwt_expire_minutes —
# validation_alias, no prefix).
# Generate a strong secret, e.g.:  openssl rand -hex 32
# NOTE: default algorithm RS256 expects an RSA key; use HS256 with a shared
# secret if that matches your deployment (keep algorithm + key material
# consistent across restarts or existing tokens stop validating).
# -----------------------------------------------------------------------------
JWT_SECRET="<GENERATE_WITH_openssl_rand_hex_32>"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="30"

# -----------------------------------------------------------------------------
# First-run admin bootstrap (src/ate_cloud/api/v1/users.py).
# Used ONLY when no users exist yet (initial admin account). The old .24 unit
# set ATE_ADMIN_USERNAME/ATE_ADMIN_PASSWORD directly; prefer the env file.
# -----------------------------------------------------------------------------
ATE_ADMIN_USERNAME="admin"
ATE_ADMIN_PASSWORD="<FIRST_RUN_ADMIN_PASSWORD>"

# -----------------------------------------------------------------------------
# Storage / paths
# -----------------------------------------------------------------------------
# Edge recording JSONL files consumed by the execution-diff endpoint
# (config.py: recordings_dir, alias ATE_RECORDINGS_DIR; default
# /var/log/test_platform/recordings).
ATE_RECORDINGS_DIR="/var/log/test_platform/recordings"
# Root for user-uploaded scripts (src/ate_cloud/main.py; defaults to
# <repo>/scripts). Set if scripts live outside the deploy tree.
# SCRIPTS_ROOT_DIR="/home/rpdzkj/ATEStudio/scripts"

# Upload-queue pruning (config.py: upload_queue_max_size / *_max_age_seconds).
ATE_CLOUD_UPLOAD_QUEUE_MAX_SIZE="1000"
ATE_CLOUD_UPLOAD_QUEUE_MAX_AGE_SECONDS="3600"

# -----------------------------------------------------------------------------
# Feature flags (validation_alias, no ATE_CLOUD_ prefix)
# -----------------------------------------------------------------------------
# ATE_SIMULATION_MODE=true -> mock instruments (no hardware). The CLOUD deploy
# leaves it false; edge workers set it true (config/edge-node.env.example).
ATE_SIMULATION_MODE="false"
# ATE_DEV_MODE=true -> relaxed checks / debug features. MUST be false in prod.
ATE_DEV_MODE="false"
# Auto-push AI diagnosis results to operator UI over NATS.
ATE_AI_DIAGNOSE_AUTO="false"

# -----------------------------------------------------------------------------
# Neo4j — RETIRED, and now removed from config.py as well.
#
# The note here used to read "kept in config.py for rollback reference". There
# was nothing to roll back to: no module read either field, the host had no
# Neo4j installed (verified 2026-09-30 on 192.168.5.25 — no binary, unit,
# process, data directory, or listening port), and its replacement FalkorDB had
# never been started either. Two dead settings and a "rollback reference" note
# is not a safety net; it is a description of a system that no longer exists.
# -----------------------------------------------------------------------------
