# =============================================================================
# ATE Studio — Environment Variable Template
# =============================================================================
# Copy this file to `.env`, fill in your values, and docker-compose / the app
# will pick them up automatically.
#
#   cp env.template .env
#
# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------

# Database backend: sqlite | postgresql | mysql
ATE_CLOUD_DATABASE_TYPE=sqlite

# SQLite: path relative to project root (only used when DATABASE_TYPE=sqlite)
ATE_CLOUD_SQLITE_DB_PATH=data/ate_platform.db

# PostgreSQL (only used when DATABASE_TYPE=postgresql)
ATE_CLOUD_PG_HOST=localhost
ATE_CLOUD_PG_PORT=5432
ATE_CLOUD_PG_USER=postgres
ATE_CLOUD_PG_PASSWORD=postgres
ATE_CLOUD_PG_DATABASE=ate_platform

# ---------------------------------------------------------------------------
# NATS JetStream Configuration
# ---------------------------------------------------------------------------
ATE_CLOUD_NATS_URL=nats://localhost:4222

# ---------------------------------------------------------------------------
# Qdrant Vector Database Configuration
# ---------------------------------------------------------------------------
ATE_CLOUD_QDRANT_URL=http://localhost:6333
ATE_CLOUD_EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# LLM Configuration (AI-assisted script generation, diagnosis, RAG)
# ---------------------------------------------------------------------------
# API key for LLM provider (OpenAI, Aliyun DashScope, etc.)
OPENAI_API_KEY=your-api-key-here

# Base URL for LLM API. For OpenAI, leave empty (uses default).
# For Aliyun DashScope: https://llm-xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=

# Chat model name (e.g. gpt-4o-mini, qwen-plus)
OPENAI_MODEL=gpt-4o-mini

# Embedding model name (e.g. text-embedding-3-small, qwen3.7-text-embedding)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Neo4j Graph Database Configuration (knowledge graph, failure tracing)
# ---------------------------------------------------------------------------
NEO4J_URL=bolt://localhost:7687
NEO4J_PASSWORD=your-neo4j-password-here

# ---------------------------------------------------------------------------
# JWT Authentication Configuration
# ---------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-key-here
JWT_ALGORITHM=RS256
JWT_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Development & Debug
# ---------------------------------------------------------------------------
ATE_DEV_MODE=false

# ---------------------------------------------------------------------------
# Simulation Mode — when enabled, all instrument drivers return simulated
# responses (no physical hardware required)
# ---------------------------------------------------------------------------
ATE_SIMULATION_MODE=false