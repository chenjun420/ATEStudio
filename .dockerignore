# Version control
.git
.gitignore
.gitattributes

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
*.egg
dist/
build/

# Virtual environments
.venv
venv/
env/

# Testing and linting caches
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov/
.coverage
coverage.xml

# Frontend (built separately, not needed in Python image)
frontend/
node_modules/

# Data and runtime files
data/
*.db
*.sqlite
*.sqlite3

# Docker files (not needed inside image)
Dockerfile
docker-compose.yml
docker-compose.*.yml
.dockerignore

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Documentation (not needed at runtime)
README.md
AGENTS.md
*.md

# Project tooling and metadata
.omo/
.codegraph/
tests/
examples/

# Environment files (secrets must not be baked into image)
.env
.env.*
!.env.example

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
