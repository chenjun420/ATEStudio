node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Where build_bundle.sh writes the tarball the deploy copies to the host. It is
# build output and must never be committed: the repository is source, and a repo
# that grows by 16.6 MB every time someone edits a stylesheet eventually hits
# GitHub's 1 GB warning and 5 GB hard block with no way back short of rewriting
# history.
.spa-bundle/

