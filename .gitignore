# =============================================================================
# Frontend
# =============================================================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# `spa-bundle/` is the committed copy of frontend/dist/, and it must NOT be
# added here. frontend/dist/ is ignored because it is a build product; ignoring
# the committed copy too would be self-defeating, since git reports changes to
# tracked files regardless of .gitignore — a developer's local `npm run build`
# would then rewrite 198 tracked files and leave the tree permanently dirty.
# Nothing ever writes spa-bundle/ into a working tree (publish_dist.sh builds it
# with plumbing, into a temporary index), so it never shows up untracked.

# publish_dist.sh's report of why it published or skipped. It lives at the
# repository root rather than inside dist/ because two of its three exit paths
# run before the build, when a fresh CI checkout has no dist/ yet.
.publish-outcome

